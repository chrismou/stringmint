{
    "preset": "psr12",
    "rules": {
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        },
        "fully_qualified_strict_types": {
            "import_symbols": true
        },
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": [
                "class",
                "function",
                "const"
            ]
        },
        "no_unused_imports": true
    }
}
